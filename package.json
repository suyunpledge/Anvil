{
  "name": "anvil-ide",
  "version": "0.1.7",
  "description": "Anvil IDE — VSCode 开源编辑器内核(Monaco) + 自研中文界面 + Anvil 本地模型编码代理",
  "main": "./out/main/index.js",
  "author": "ku-suyun",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "bench:chat": "node tests/model-tools.live.cjs",
    "build": "electron-vite build",
    "installer": "npm run build && electron-builder --config packaging/windows.cjs --win nsis --x64 --publish never",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "bench:work": "node tests/work-models.live.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "26.0.12",
    "electron-vite": "^2.3.0",
    "node-win-x64": "24.19.0",
    "rcedit": "5.0.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  }
}
